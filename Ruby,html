<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClanMod - Code Playground</title>
    <style>
      body {
        font-family: Arial, Helvetica Neue, sans-serif;
        background-color: #121212;
        color: #e0e0e0;
        margin: 0;
        padding: 20px;
      }

      main {
        max-width: 900px;
        margin: 0 auto;
      }

      /* Code Editor Container */
      .editor-container {
        background-color: #1e1e1e;
        border-radius: 6px;
        border: 1px solid #333;
        margin-bottom: 16px;
        overflow: hidden;
      }

      .editor-toolbar {
        background-color: #252526;
        padding: 8px 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #333;
      }

      .lang-buttons {
        display: flex;
        gap: 6px;
      }

      .lang-btn {
        background: #333;
        color: #aaa;
        border: 1px solid #444;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        font-weight: bold;
      }

      .lang-btn.active {
        background: #007acc;
        color: #fff;
        border-color: #007acc;
      }

      .run-btn {
        background: #28a745;
        color: #fff;
        border: none;
        padding: 6px 16px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        font-weight: bold;
      }

      .run-btn:hover {
        background: #218838;
      }

      .code-textarea {
        width: 100%;
        height: 180px;
        background-color: #1e1e1e;
        color: #d4d4d4;
        border: none;
        padding: 12px;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 14px;
        line-height: 1.5;
        resize: vertical;
        box-sizing: border-box;
        outline: none;
      }

      /* Console Styling */
      .console {
        background-color: #1e1e1e;
        border-radius: 6px;
        border: 1px solid #333;
        font-family: 'Consolas', 'Courier New', monospace;
        padding: 12px;
        max-height: 250px;
        overflow-y: auto;
      }

      .console-output {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .log-entry {
        display: flex;
        gap: 8px;
        font-size: 13px;
        line-height: 1.4;
      }

      .timestamp {
        color: #858585;
      }

      .level {
        font-weight: bold;
        min-width: 50px;
      }

      .message {
        color: #d4d4d4;
        white-space: pre-wrap;
      }

      /* Log Level Colors */
      .log-entry.debug .level { color: #35b3ee; }
      .log-entry.info  .level { color: #4ec9b0; }
      .log-entry.warn  .level { color: #ce9178; }
      .log-entry.error .level { color: #f14c4c; }

      footer {
        margin-top: 20px;
        text-align: center;
        color: #666;
        font-size: 12px;
      }
    </style>
</head>
<body>
    <main>
        <!-- Code Writer Area -->
        <div class="editor-container">
          <div class="editor-toolbar">
            <div class="lang-buttons">
              <button class="lang-btn active" onclick="setLanguage('php')">PHP</button>
              <button class="lang-btn" onclick="setLanguage('ruby')">Ruby</button>
              <button class="lang-btn" onclick="setLanguage('python')">Python</button>
            </div>
            <button class="run-btn" onclick="runCode()">Run Code ▶</button>
          </div>
          <textarea id="codeEditor" class="code-textarea" spellcheck="false" placeholder="Write your code here..."></textarea>
        </div>

        <!-- Output Console -->
        <div class="console">
          <div class="console-output" id="console-output">
            <!-- Log entries dynamically appended here -->
          </div>
        </div>

        <!-- Log Entry Template -->
        <template id="log-entry-template">
          <div class="log-entry">
            <span class="timestamp"></span>
            <span class="level"></span>
            <span class="message"></span>
          </div>
        </template>

        <p>Converts <code>index.php</code>, <code>script.py</code>, and <code>index.rb</code> instantly.</p>
    </main>

    <footer>
        <p>&copy; 2026 ClanMod</p>
    </footer>

    <script>
      // Code presets for each language
      const defaultTemplates = {
        php: "<?php\necho 'Hello from PHP!';\n$logger->info('Processing data...');",
        ruby: "puts 'Hello from Ruby!'\nlogger.info('Processing data...')",
        python: "print('Hello from Python!')\nlogger.info('Processing data...')"
      };

      let currentLanguage = 'php';
      const editor = document.getElementById('codeEditor');
      editor.value = defaultTemplates[currentLanguage];

      function setLanguage(lang) {
        currentLanguage = lang;
        document.querySelectorAll('.lang-btn').forEach(btn => {
          btn.classList.toggle('active', btn.textContent.toLowerCase() === lang);
        });
        editor.value = defaultTemplates[lang];
      }

      class ConsoleLogger {
        constructor(outputId = 'console-output', templateId = 'log-entry-template') {
          this.container = document.getElementById(outputId);
          this.template = document.getElementById(templateId);
        }

        log(level, message) {
          if (!this.container || !this.template) return;

          const clone = this.template.content.cloneNode(true);
          const entry = clone.querySelector('.log-entry');
          
          const now = new Date();
          const timestamp = now.toISOString().replace('T', ' ').substring(0, 19);

          entry.classList.add(level.toLowerCase());
          clone.querySelector('.timestamp').textContent = `[${timestamp}]`;
          clone.querySelector('.level').textContent = level.toUpperCase();
          clone.querySelector('.message').textContent = message;

          this.container.appendChild(clone);
          this.container.scrollTop = this.container.scrollHeight;
        }

        debug(msg) { this.log('debug', msg); }
        info(msg)  { this.log('info', msg); }
        warn(msg)  { this.log('warn', msg); }
        error(msg) { this.log('error', msg); }
      }

      const logger = new ConsoleLogger();

      function runCode() {
        const code = editor.value;
        logger.info(`Executing ${currentLanguage.toUpperCase()} code...`);
        logger.debug(code);
      }
    </script>
</body>
</html>
